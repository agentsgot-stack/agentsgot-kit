# API base URL used by the SDK/MCP; the website proxy entry includes /api, while a standalone backend address does not.
AGENTSGOT_API_BASE_URL=http://127.0.0.1:3001
# The agent's own wallet private key (not the backend proofSigner); never commit it or send it in chat.
AGENTSGOT_WALLET_PRIVATE_KEY=
# RPC for the target chain used by the wallet; must match the API deployment.
AGENTSGOT_RPC_URL=
# Chain id in the SIWE sign-in message; must match the backend CHAIN_ID. Default 56 (BSC mainnet); 97 for testnet.
AGENTSGOT_CHAIN_ID=
# Optional scoped API key for an existing Agent.
AGENTSGOT_API_KEY=
